---
// The Branchwork mark: one trunk, three branches, one new bud in the accent.
// `grow` draws it once per visit (the header); `scroll` draws it as it scrolls
// into view (the contact section). Both are the same motion as the launch video.
interface Props {
  size?: number;
  class?: string;
  grow?: 'load' | 'scroll';
}
const { size = 28, class: className, grow } = Astro.props;
---

<svg
  class:list={['mark', grow && `grow-${grow}`, className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="5.5"
  stroke-linecap="round"
>
  <path class="trunk" d="M32 60 V10" pathLength="1" />
  <path class="branch-l" d="M32 43 C32 31 15 32 15 17" pathLength="1" />
  <path class="branch-r" d="M32 36 C32 27 49 30 49 20" pathLength="1" />
  <circle class="bud" cx="32" cy="7" r="5.5" fill="var(--accent)" stroke="none" />
</svg>

<style>
  .mark {
    flex: none;
    overflow: visible;
  }

  .bud {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .grow-load path,
    .grow-scroll path {
      stroke-dasharray: 1 2;
    }

    /* Once per visit: the flag is set by the inline script in Base.astro. */
    :global(:root:not([data-grown])) .grow-load {
      path {
        animation: mark-draw 0.7s cubic-bezier(0.45, 0, 0.2, 1) both;
      }
      .trunk {
        animation-delay: 0.15s;
      }
      .branch-l {
        animation-delay: 0.55s;
      }
      .branch-r {
        animation-delay: 0.68s;
      }
      .bud {
        animation: mark-bud 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.05s both;
      }
    }

    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      .grow-scroll {
        view-timeline: --mark;

        path,
        .bud {
          animation: mark-draw linear both;
          animation-timeline: --mark;
        }
        .trunk {
          animation-range: entry 0% entry 60%;
        }
        .branch-l {
          animation-range: entry 40% entry 85%;
        }
        .branch-r {
          animation-range: entry 50% entry 92%;
        }
        .bud {
          animation-name: mark-bud;
          animation-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
          animation-range: entry 80% entry 100%;
        }
      }
    }
  }

  /* Round caps paint a dot on a zero-length dash, so the stroke stays hidden
     until it starts to draw. */
  @keyframes mark-draw {
    0% {
      stroke-dashoffset: 1;
      stroke-opacity: 0;
    }
    1% {
      stroke-opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes mark-bud {
    from {
      scale: 0;
    }
  }
</style>
