---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="wrap missing">
    <h1>This branch hasn't grown yet.</h1>
    <p>The page you were looking for isn't here. It may have moved, or it never existed.</p>
    <a class="button" href="/">Back to the studio <span class="arrow" aria-hidden="true">→</span></a>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-top: clamp(4rem, 12vw, 9rem);
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 14ch;
  }

  p {
    color: var(--muted);
    max-width: 44ch;
    margin-bottom: 0.75rem;
  }
</style>
